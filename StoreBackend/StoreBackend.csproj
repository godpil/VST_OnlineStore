<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Version>1.0.0</Version>
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<FileVersion>1.0.0.0</FileVersion>
		<InformationalVersion>1.0.0</InformationalVersion>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Grpc.AspNetCore" Version="2.80.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Shared\VstOnlineStore.Observability\VstOnlineStore.Observability.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Protobuf Include="..\Contracts\storebackend.proto" GrpcServices="Server" Link="Protos\storebackend.proto" />
	</ItemGroup>

	<ItemGroup>
		<Content Update="Data\warehouse-products.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Update="Data\warehouse-products.reservations.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

</Project>
