        <mxCell id="HqzzmyD6XFuR1QTdJvPv-28" parent="1" style="shape=card;whiteSpace=wrap;html=1;align=left;" value="&amp;nbsp;&amp;gt; Billing-Microservice erzeugen&amp;nbsp;&lt;div&gt;&amp;nbsp;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;(protokolliert Ergebnis)&lt;br&gt;&lt;div&gt;&amp;nbsp;&amp;gt; PaymentOptionen einbinden&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&amp;gt; zB. StripeAdapter,&lt;br&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Chargebee&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Paypal?&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;gt; Organisiert in Fassade-Pattern&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;(kein direkter Zugriff auf einen&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;konkreten Anbieter)&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;- Weitere Anbieter müssen ohne&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;das der vorh. Code geändert wird,&lt;br&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;hinzufügbar sein.&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;- Fassadenfunktionen sind gegeben mit:&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&amp;nbsp; charge(orderId, amount, &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;currency),&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&amp;nbsp; refund(transactionId, &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;amount),&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&amp;nbsp;&lt;/span&gt;&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;getStatus(transactionId)&quot;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp;&amp;gt; Der aktive Anbieter wird per Umgebungsvariable oder Konfig gesetzt (nicht per Code)&lt;/div&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="330" width="290" x="495" y="430" as="geometry" />
        </mxCell>
