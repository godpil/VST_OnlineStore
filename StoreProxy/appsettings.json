{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  "AllowedHosts": "*",

  "ReverseProxy": {
    "Routes": {
      "featured-products-route": {
        "ClusterId": "shop-service",
        "Match": {
          "Path": "/api/products/featured"
        }
      },

      "checkout-route": {
        "ClusterId": "shop-service",
        "Match": {
          "Path": "/api/checkout"
        }
      },

      "service-status-route": {
        "ClusterId": "shop-service",
        "Match": {
          "Path": "/api/services/status"
        }
      }
    },

    "Clusters": {
      "shop-service": {
        "Destinations": {
          "shop-service-1": {
            "Address": "http://localhost:6668/"
          }
        }
      }
    }
  }
}
