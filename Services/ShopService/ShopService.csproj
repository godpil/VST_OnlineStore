<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" Version="3.34.1" />
    <PackageReference Include="Grpc.Net.ClientFactory" Version="2.80.0" />
    <PackageReference Include="Grpc.Tools" Version="2.80.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Protobuf Include="..\..\Contracts\warehouseservice.proto" GrpcServices="Client" Link="Protos\warehouseservice.proto" />
    <Protobuf Include="..\..\Contracts\billingservice.proto" GrpcServices="Client" Link="Protos\billingservice.proto" />
    <Protobuf Include="..\..\Contracts\invoiceservice.proto" GrpcServices="Client" Link="Protos\invoiceservice.proto" />
    <Protobuf Include="..\..\Contracts\auditservice.proto" GrpcServices="Client" Link="Protos\auditservice.proto" />
  </ItemGroup>

</Project>
